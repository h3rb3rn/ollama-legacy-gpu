# Tesla M10/M60 — qualified CUDA12 Ollama 0.35.0 fork.
# Use a homogeneous GPU pool and an immutable, validated image.
# Maxwell supports the generic CUDA Flash Attention kernels in this build;
# Tensor Cores are not required. This example does not apply to K80/CUDA11.
#
# Q4 is the production default requested on 2026-10-01. Model weight
# quantization is independent. Q4/Q8 need FA compiled AND enabled at runtime.
# Lower cache memory does not guarantee a speed gain or unchanged quality.
# The API can override context; validate each model at its intended size.

OLLAMA_HOST=0.0.0.0:11434
OLLAMA_INTERNAL_PORT=11434
OLLAMA_GPU_AUTODETECT=0
OLLAMA_AUTO_OPTIMIZE=0
OLLAMA_CONTEXT_LENGTH=65536
OLLAMA_KEEP_ALIVE=30m
OLLAMA_LOAD_TIMEOUT=20m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_SCHED_SPREAD=true
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q4_0
OLLAMA_MULTIUSER_CACHE=false
OLLAMA_GPU_OVERHEAD=268435456
OLLAMA_METRICS=true
# Preserve host-specific Docker GPU reservations; do not assume GPU indices.
# Large hybrid/MoE models may require num_batch=64 per request to fit workspace.
